# Copy to .env for local testing. On Render, set these in the dashboard.
NINEROUTER_API_KEY=your_9router_api_key_here
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
PORT=3000

# Optional: override upstream paths for media endpoints if 9Router
# exposes them under different routes.
NINEROUTER_IMAGE_PATH=/v1/images/generations
NINEROUTER_VIDEO_PATH=/v1/videos/generations
NINEROUTER_AUDIO_PATH=/v1/audio/transcriptions
